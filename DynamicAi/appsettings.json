{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "EnableContextAnalysisLogs": true
  },
  "ConnectionStrings": {
    "AppDbContextConnection": "Server=.;Database=DynamicAi_AppDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "DefaultConnection": ""
  },
  "Gemini": {
    "ApiKey": "",
    "ChatModel": "gemini-2.5-flash-lite",
    "PredictModel": "gemini-2.5-flash-lite",
    "EmbeddingModel": "gemini-embedding-001"
  },
  "Qdrant": {
    "Host": "",
    "ApiKey": "",
    "CollectionName": "erp_knowledge_base_v3_indexed",
    "IntentCollectionName": "intent_examples"
  },
  "IntentRouter": {
    "ConfidenceThreshold": 0.75
  },
  "Database": {
    "Name": "QualityControl"
  },
  "Caching": {
    "QueryCache": {
      "Enabled": true,
      "CollectionName": "query_cache",
      "SimilarityThreshold": 0.97,
      "TTLDays": 7
    },
    "RagContextCache": {
      "Enabled": true,
      "TTLMinutes": 240
    },
    "SessionMemory": {
      "Enabled": true,
      "TTLMinutes": 30,
      "MaxHistoryTurns": 5
    },
    "GeminiCache": {
      "Enabled": false
    }
  },
  "LlmProviderPricing": {
    "ActiveProvider": "Gemini",
    "Providers": {
      "Gemini": {
        "DisplayName": "Google Gemini",
        "Models": {
          "gemini-2.5-flash-lite": {
            "InputCostPerMillionTokens": 0.10,
            "OutputCostPerMillionTokens": 0.40,
            "CachedInputCostPerMillionTokens": 0.025
          },
          "gemini-2.5-flash": {
            "InputCostPerMillionTokens": 0.15,
            "OutputCostPerMillionTokens": 0.60,
            "CachedInputCostPerMillionTokens": 0.0375
          },
          "gemini-2.0-flash": {
            "InputCostPerMillionTokens": 0.10,
            "OutputCostPerMillionTokens": 0.40,
            "CachedInputCostPerMillionTokens": 0.025
          },
          "gemini-embedding-001": {
            "InputCostPerMillionTokens": 0.10,
            "OutputCostPerMillionTokens": 0.0,
            "CachedInputCostPerMillionTokens": 0.0
          }
        }
      },
      "OpenAI": {
        "DisplayName": "OpenAI",
        "Models": {
          "gpt-4o-mini": {
            "InputCostPerMillionTokens": 0.15,
            "OutputCostPerMillionTokens": 0.60,
            "CachedInputCostPerMillionTokens": 0.075
          }
        }
      }
    },
    "DailyBudgetUsd": 1.00,
    "WarningThresholdPercent": 80,
    "EnforceHardLimit": true,
    "ProtectedEndpoints": [
      "/test/ask",
      "/api/dataseeder/seed",
      "/api/dataseeder/seed-intents",
      "/api/feedback/dislike",
      "/api/intent-review/clear-by-question",
      "/api/query-cache/clear-by-question"
    ]
  },
  "AllowedHosts": "*"
}