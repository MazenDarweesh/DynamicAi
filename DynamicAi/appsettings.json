{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "AppDbContextConnection": "Server=.;Database=DynamicAi_AppDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "DefaultConnection": ""
  },
  "Gemini": {
    "ApiKey": "",
    "ChatModel": "gemini-2.5-flash",
    "EmbeddingModel": "gemini-embedding-001"
  },
  "Qdrant": {
    "Host": "",
    "ApiKey": "",
    "CollectionName": "erp_knowledge_base_v3_indexed",
    "IntentCollectionName": "intent_examples"
  },
  "IntentRouter": {
    "ConfidenceThreshold": 0.75
  },
  "Database": {
    "Name": "QualityControl"
  },
  "Caching": {
    "QueryCache": {
      "Enabled": true,
      "CollectionName": "query_cache",
      "SimilarityThreshold": 0.97,
      "TTLDays": 7
    },
    "RagContextCache": {
      "Enabled": true,
      "TTLMinutes": 240
    },
    "SessionMemory": {
      "Enabled": true,
      "TTLMinutes": 30,
      "MaxHistoryTurns": 5
    }
  },
  "AllowedHosts": "*"
}