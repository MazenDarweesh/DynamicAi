# ============================================================================
# DynamicAI - Environment Variables Template
# ============================================================================
# Instructions:
#   1. Copy this file to .env: cp .env.example .env
#   2. Fill in your actual values below
#   3. NEVER commit .env to source control!
# ============================================================================

# ----------------------------------------------------------------------------
# System Database (Docker)
# ----------------------------------------------------------------------------
SA_PASSWORD="YourStrong!Passw0rd123"

# ----------------------------------------------------------------------------
# Production Target Database (External)
# ----------------------------------------------------------------------------
PRODUCTION_DB_CONNECTION_STRING="Server=your_server_ip;Database=YourDB;User Id=YourUser;Password=YourPassword;MultipleActiveResultSets=True;TrustServerCertificate=True;Encrypt=False;"
PRODUCTION_DB_NAME="YourDB"

# ----------------------------------------------------------------------------
# AI Models & Providers
# ----------------------------------------------------------------------------
GEMINI_API_KEY="dummy_gemini_api_key_here"

GENERATION_MODEL_ID_LITERAL=["gpt-4o-mini", "gpt-4o", "gemini-2.5-flash-lite", "gemini-2.5-flash"]
GEMINI_CHAT_MODEL="gemini-2.5-flash-lite"
GEMINI_PREDICT_MODEL="gemini-2.5-flash-lite"

EMBEDDING_MODEL_ID_LITERAL=["embed-multilingual-light-v3.0", "gemini-embedding-001", "text-embedding-3-small"]
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_MODEL_SIZE=384

INPUT_DEFAULT_MAX_CHARACTERS=1024
GENERATION_DEFAULT_MAX_TOKENS=200
GENERATION_DEFAULT_TEMPERATURE=0.1

# ----------------------------------------------------------------------------
# Vector DB Config
# ----------------------------------------------------------------------------
VECTOR_DB_BACKEND_LITERAL=["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND="QDRANT"

QDRANT_HOST_LITERAL=["http://qdrant_local", "https://[your-cluster].cloud.qdrant.io"]
QDRANT_HOST="http://qdrant_local"
QDRANT_PORT=6334
QDRANT_API_KEY=""

# ----------------------------------------------------------------------------
# System Feature Switchers
# ----------------------------------------------------------------------------
FEATURES_INTENT_ENABLED="false"
FEATURES_CONDENSER_ENABLED="false"

# ----------------------------------------------------------------------------
# Caching Feature Flags
# ----------------------------------------------------------------------------
CACHING_QUERY_ENABLED="true"
CACHING_RAG_ENABLED="true"
CACHING_SESSION_ENABLED="true"
CACHING_GEMINI_ENABLED="false"
